  {
    "name": "invalid_deep_link_keeps_push",
    "payload": {
      "flowbiz": "{\"v\":1,\"type\":\"promo\",\"deep_link\":\"ht!tp: //not a url  \"}"
    },
    "expected": {
      "version": 1,
      "type": "promo",
      "title": null,
      "body": null,
      "deepLink": "ht!tp: //not a url  ",
      "data": {}
    },
    "note": "deepLink here is the RAW string the parser keeps; the platform URL type may reject it (iOS URL(string:) -> nil field) while the push itself is still returned"
