  {
    "name": "non_string_marker_dict",
    "payload": {
      "flowbiz": {
        "v": 1,
        "type": "promo",
        "title": "nested object"
      }
    },
    "expected_android": null,
    "expected_ios": {
      "version": 1,
      "type": "promo",
      "title": "nested object",
      "body": null,
      "deepLink": null,
      "data": {}
    },
    "note": "SPEC 10.2: the contract is a JSON-encoded STRING on both platforms. FCM data payloads are Map<String,String>, so a dict value cannot occur on Android (-> null). APNs userInfo CAN nest a dictionary; iOS tolerates it leniently."
  }
